#!/bin/bash
# oma-type: CLI for the Oma Type plugin inside omarchy-shell

set -uo pipefail

PLUGIN_ID="juanstudy.oma-type"
IPC_TARGET="oma-type"

self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd "$(dirname "$self")/.." && pwd)
plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
plugin_link="$plugins_dir/$PLUGIN_ID"
apps_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

installed_links() {
  local link
  for link in "$plugin_link" "$plugin_link".dev-*; do
    [[ -L $link && $(readlink -f "$link") == "$repo" ]] && printf '%s\n' "$link"
  done
}

current_link() { installed_links | tail -n1; }

usage() {
  cat <<USAGE
Usage: oma-type <command>

App
  toggle                 Show or hide the typing test overlay
  show | hide            Show or hide the overlay
  focus                  Toggle focus / maximized mode (Shortcut: F11)
  reset                  Reset the current typing test
  ping                   Ping the IPC target

Background & Customization
  bg [image-path]        Set background image (or toggle default wallpaper)
  bg-toggle              Toggle background image on/off (Shortcut: Ctrl+B)
  dither-toggle          Toggle Bayer dithering shader on/off (Shortcut: Ctrl+D)
  vignette-toggle        Toggle perimeter vignette fade on/off (Shortcut: Ctrl+V)
  accent-toggle          Toggle adaptive wallpaper accent on/off
  palette [image-path]   Extract adaptive accent color from wallpaper
  config                 Print current configuration

Setup
  install                Link plugin into omarchy-shell and install .desktop entry
  uninstall              Disable and unlink the plugin
  reload                 Force reload plugin in omarchy-shell (bypasses cache)
  doctor                 Check status of shell, plugin, and IPC
USAGE
}

die() { echo "oma-type: $*" >&2; exit 1; }

ipc() { omarchy-shell "$IPC_TARGET" "$@"; }

need_shell() {
  command -v omarchy-shell >/dev/null || die "omarchy-shell not found; oma-type runs inside Omarchy shell"
}

cmd_install() {
  need_shell
  [[ -f $repo/manifest.json ]] || die "manifest.json missing at $repo"

  mkdir -p "$plugins_dir"
  mkdir -p "$HOME/.local/share/oma-type"
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/oma-type"
  local old
  while IFS= read -r old; do rm -f "$old"; done < <(installed_links)

  local dev_link="$plugin_link.dev-$(date +%s%N)"
  ln -sfn "$repo" "$dev_link"
  echo "linked $dev_link -> $repo"

  mkdir -p "$HOME/.local/bin"
  if [[ ! -e $HOME/.local/bin/oma-type || -L $HOME/.local/bin/oma-type ]]; then
    ln -sfn "$self" "$HOME/.local/bin/oma-type"
    echo "linked ~/.local/bin/oma-type"
  fi

  # Install desktop entry so oma-cast indexes it
  mkdir -p "$apps_dir"
  if [[ -f $repo/oma-type.desktop ]]; then
    cp "$repo/oma-type.desktop" "$apps_dir/oma-type.desktop"
    echo "installed $apps_dir/oma-type.desktop"
  fi

  omarchy-shell -q shell rescanPlugins 2>/dev/null || true

  local out i
  for i in $(seq 1 50); do
    out=$(omarchy plugin enable "$PLUGIN_ID" 2>&1) && break
    [[ $out == *"not ready"* || $out == *"could not find"* || $out == *"not known"* ]] || break
    sleep 0.1
  done
  [[ -n $out ]] && echo "$out"

  for i in $(seq 1 60); do
    [[ $(omarchy-shell "$IPC_TARGET" ping 2>/dev/null) == "ok" ]] && { echo "oma-type is running"; return 0; }
    sleep 0.1
  done
  die "plugin did not answer; check shell log with: qs log -n -p \"\$OMARCHY_PATH/shell\""
}

cmd_uninstall() {
  need_shell
  omarchy plugin disable "$PLUGIN_ID" 2>/dev/null || true
  local link
  while IFS= read -r link; do
    [[ -n $link ]] && rm -f "$link" && echo "removed $link"
  done < <(installed_links)
  omarchy-shell -q shell rescanPlugins 2>/dev/null || true

  if [[ -L $HOME/.local/bin/oma-type && $(readlink -f "$HOME/.local/bin/oma-type") == "$self" ]]; then
    rm -f "$HOME/.local/bin/oma-type" && echo "removed ~/.local/bin/oma-type"
  fi
  if [[ -f $apps_dir/oma-type.desktop ]]; then
    rm -f "$apps_dir/oma-type.desktop" && echo "removed $apps_dir/oma-type.desktop"
  fi
}

cmd_reload() {
  need_shell
  local old
  while IFS= read -r old; do rm -f "$old"; done < <(installed_links)
  local dev_link="$plugin_link.dev-$(date +%s%N)"
  ln -sfn "$repo" "$dev_link"
  echo "relinked $dev_link -> $repo"
  omarchy-shell -q shell rescanPlugins 2>/dev/null || true
  omarchy plugin enable "$PLUGIN_ID" 2>/dev/null || true
}

cmd_doctor() {
  local bad=0
  check() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$label"; else printf '  FAIL  %s\n' "$label"; bad=1; fi
  }
  echo "oma-type doctor"
  check "omarchy-shell is installed" command -v omarchy-shell
  check "omarchy-shell is running" omarchy-shell shell ping
  check "plugin is linked into $plugins_dir" test -n "$(current_link)"
  check "plugin is enabled" bash -c "omarchy plugin list --json 2>/dev/null | grep -q '\"id\":\"$PLUGIN_ID\"[^}]*\"enabled\":true'"
  check "plugin answers IPC" bash -c "[[ \$(omarchy-shell $IPC_TARGET ping) == ok ]]"
  check "desktop launcher is installed" test -f "$apps_dir/oma-type.desktop"
  return $bad
}

cmd_bg() {
  local target_path="${1:-}"
  local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/oma-type/settings.json"
  mkdir -p "$(dirname "$config_file")"

  if [[ -n "$target_path" ]]; then
    if [[ ! -f "$target_path" && ! -f "$repo/$target_path" ]]; then
      die "image file not found: $target_path"
    fi
    [[ ! -f "$target_path" ]] && target_path="$repo/$target_path"
    target_path=$(readlink -f "$target_path")

    if omarchy-shell "$IPC_TARGET" ping >/dev/null 2>&1; then
      omarchy-shell "$IPC_TARGET" setBackground "$target_path" >/dev/null 2>&1 || true
    else
      node -e '
        const fs = require("fs");
        const file = process.argv[1];
        const img = process.argv[2];
        let s = {};
        try { s = JSON.parse(fs.readFileSync(file, "utf8")); } catch(e) {}
        s.bgImageEnabled = true;
        s.bgImagePath = img;
        fs.writeFileSync(file, JSON.stringify(s, null, 2));
      ' "$config_file" "$target_path"
    fi
    echo "Background set to: $target_path (enabled)"
  else
    local default_wall="$repo/assets/wallpapers/anime-sky.png"
    if omarchy-shell "$IPC_TARGET" ping >/dev/null 2>&1; then
      local cur_state
      cur_state=$(omarchy-shell "$IPC_TARGET" toggleBackground 2>/dev/null || echo "toggled")
      echo "Background image $cur_state"
    else
      node -e '
        const fs = require("fs");
        const file = process.argv[1];
        const def = process.argv[2];
        let s = {};
        try { s = JSON.parse(fs.readFileSync(file, "utf8")); } catch(e) {}
        if (!s.bgImagePath) s.bgImagePath = def;
        s.bgImageEnabled = !s.bgImageEnabled;
        fs.writeFileSync(file, JSON.stringify(s, null, 2));
        console.log("Background image " + (s.bgImageEnabled ? "enabled (" + s.bgImagePath + ")" : "disabled"));
      ' "$config_file" "$default_wall"
    fi
  fi
}

cmd_config() {
  local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/oma-type/settings.json"
  if [[ -f "$config_file" ]]; then
    cat "$config_file"
  else
    echo "No settings.json found yet at $config_file"
  fi
}

case "${1:-}" in
  toggle|show|hide|reset) need_shell; ipc "$1" >/dev/null ;;
  focus|focus-toggle) need_shell; ipc toggleFocus ;;
  ping) need_shell; ipc ping ;;
  bg) shift; cmd_bg "${1:-}" ;;
  bg-toggle) need_shell; ipc toggleBackground >/dev/null || cmd_bg ;;
  dither-toggle) need_shell; ipc toggleDither >/dev/null ;;
  vignette-toggle) need_shell; ipc toggleVignette >/dev/null ;;
  accent-toggle) need_shell; ipc toggleAdaptiveAccent >/dev/null || true ;;
  palette) shift; "$repo/bin/extract-accent" "${1:-}" ;;
  config) cmd_config ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  reload) cmd_reload ;;
  doctor) cmd_doctor ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
